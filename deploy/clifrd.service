# clifr flight recorder.
#
# Installed by the clifrd package (.deb/.rpm, see packaging/). By hand:
#   install -m 0755 clifrd /usr/sbin/ && install -m 0755 clifr /usr/bin/
#   install -D -m 0644 deploy/clifr-sysusers.conf /usr/lib/sysusers.d/clifr.conf && systemd-sysusers
#   (the clifr group: its members can read the recording with clifr, without root)
#   install -D -m 0644 deploy/clifrd.yml /etc/clifr/clifrd.yml   (the settings)
#   install -m 0644 deploy/clifrd.service /etc/systemd/system/clifrd.service
#   systemctl daemon-reload && systemctl enable --now clifrd
# Stop:    systemctl stop clifrd  (SIGTERM: open rows are closed cleanly)
# Query:   clifr --at "YYYY-MM-DD HH:MM:SS" "ps aux"
# Disk:    Parquet files rotate every 5 minutes; data older than retention
#          (72h) is deleted, and the oldest hours go first above max_size (2G).

[Unit]
Description=clifr flight recorder (processes, sockets, open files, system counters)
Documentation=man:clifrd(8) man:clifr(1)
After=local-fs.target

[Service]
Type=simple
# Settings in /etc/clifr/clifrd.yml; a flag here would override the file.
ExecStart=/usr/sbin/clifrd
Restart=on-failure
RestartSec=30s
# The recording holds every user's command lines: root and the clifr group
# only (files 0640, directories 0750).
Group=clifr
StateDirectory=clifr
StateDirectoryMode=0750
UMask=0027

# Resource limits: the recorder must never compete with the real workload.
MemoryAccounting=yes
IOAccounting=yes
CPUQuota=5%
# Measured on a 22-CPU machine: 327 MiB on average (397 at most) with 20,000
# connections and 500 new ones per second, 502 MiB at most with 100,000
# connections. Above the limit the kernel kills the recorder and systemd
# restarts it: the rows since the last flush (up to 5 minutes) are lost.
MemoryMax=768M
Nice=10
IOSchedulingClass=idle

# Only the capabilities it needs (it runs as root):
#   CAP_SYS_PTRACE       read /proc/<pid>/fd, fdinfo, exe, cwd, root of any process
#   CAP_DAC_READ_SEARCH  list /proc/<pid>/fd directories owned by other users
#   CAP_NET_ADMIN        subscribe to the proc connector (and SO_RCVBUFFORCE)
#   CAP_BPF CAP_PERFMON  load and attach the eBPF programs (kernel 5.8+)
#   CAP_SYS_RESOURCE     raise RLIMIT_MEMLOCK for BPF maps (kernels before 5.11)
#   CAP_SYSLOG           read the kernel log, /dev/kmsg (with kernel.dmesg_restrict=1)
# Kernels before 5.8 (e.g. RHEL 8) have no CAP_BPF/CAP_PERFMON and need
# CAP_SYS_ADMIN for eBPF; add it there, or the recorder falls back to the
# proc connector. sock_diag needs no capability. Keep the host network
# namespace: the recorder must see the host's sockets.
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_NET_ADMIN CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE CAP_SYSLOG
AmbientCapabilities=
NoNewPrivileges=yes

# Filesystem: read-only everywhere except the state directory. Paths read
# through /proc/<pid>/fd are "magic links" and still resolve.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=no
# PrivateDevices stays off: --verify-every runs the real lsof, which needs the real /dev.
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
# Off: the recorder reads /dev/kmsg (clifr dmesg). It only reads; the
# --redact patterns are applied to the kernel log too. ProtectClock below
# limits devices to an allow list (char-rtc), so /dev/kmsg is added to it.
ProtectKernelLogs=no
DeviceAllow=/dev/kmsg r
ProtectControlGroups=yes
ProtectClock=yes
# Not ProtectHostname: it gives the service its own UTS namespace, a copy
# of the host name taken at start, so clifrd would not see it change.
ProtectHostname=no
RestrictAddressFamilies=AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
