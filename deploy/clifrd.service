# clifr flight recorder.
#
# Install:
#   install -m 0755 clifrd clifr /usr/local/sbin/
#   install -m 0644 deploy/clifrd.service /etc/systemd/system/clifrd.service
#   systemctl daemon-reload && systemctl enable --now clifrd
# Stop:    systemctl stop clifrd  (SIGTERM: open rows are closed cleanly)
# Query:   clifr ps aux --data-dir /var/lib/clifr --at "YYYY-MM-DD HH:MM:SS"
# Disk:    Parquet files rotate every 5 minutes; data older than --retention
#          (72h) is deleted, and the oldest hours go first above --max-size.

[Unit]
Description=clifr flight recorder (processes, sockets, open files, system counters)
Documentation=file:///usr/local/share/doc/clifr/README.md
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/clifrd --data-dir /var/lib/clifr --interval 30s --fd-interval 120s --cpu-budget 2% --retention 72h --max-size 2G
Restart=on-failure
RestartSec=30s
StateDirectory=clifr
StateDirectoryMode=0700

# Resource limits: the recorder must never compete with the real workload.
MemoryAccounting=yes
IOAccounting=yes
CPUQuota=5%
# Measured on a 22-CPU machine: 327 MiB on average (397 at most) with 20,000
# connections and 500 new ones per second, 502 MiB at most with 100,000
# connections. Above the limit the kernel kills the recorder and systemd
# restarts it: the rows since the last flush (up to 5 minutes) are lost.
MemoryMax=768M
Nice=10
IOSchedulingClass=idle

# Only the capabilities it needs (it runs as root):
#   CAP_SYS_PTRACE       read /proc/<pid>/fd, fdinfo, exe, cwd, root of any process
#   CAP_DAC_READ_SEARCH  list /proc/<pid>/fd directories owned by other users
#   CAP_NET_ADMIN        subscribe to the proc connector (and SO_RCVBUFFORCE)
#   CAP_BPF CAP_PERFMON  load and attach the eBPF programs (kernel 5.8+)
#   CAP_SYS_RESOURCE     raise RLIMIT_MEMLOCK for BPF maps (kernels before 5.11)
# Kernels before 5.8 (e.g. RHEL 8) have no CAP_BPF/CAP_PERFMON and need
# CAP_SYS_ADMIN for eBPF; add it there, or the recorder falls back to the
# proc connector. sock_diag needs no capability. Keep the host network
# namespace: the recorder must see the host's sockets.
CapabilityBoundingSet=CAP_SYS_PTRACE CAP_DAC_READ_SEARCH CAP_NET_ADMIN CAP_BPF CAP_PERFMON CAP_SYS_RESOURCE
AmbientCapabilities=
NoNewPrivileges=yes

# Filesystem: read-only everywhere except the state directory. Paths read
# through /proc/<pid>/fd are "magic links" and still resolve.
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=no
# PrivateDevices stays off: --verify-every runs the real lsof, which needs the real /dev.
PrivateDevices=no
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_NETLINK AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
