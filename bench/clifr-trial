def parse_ps(out):
    procs = {}
    for l in clifr_lines(out):
        f = l.split(None, 2)
        if len(f) >= 2 and f[0].isdigit():
            procs[int(f[0])] = (int(f[1]) if f[1].isdigit() else 0, f[2] if len(f) > 2 else "")
    return procs


def parse_ss(out):
    """LISTEN local addresses and ESTAB (local, peer) pairs of ss -tan."""
    listen, estab = set(), set()
    for l in clifr_lines(out):
        f = l.split()
        if len(f) < 5 or f[0] == "State":
            continue
        if f[0] == "LISTEN":
            listen.add(f[3])
        elif f[0] == "ESTAB":
            estab.add((f[3], f[4]))
    return listen, estab


MOUNT_RE = re.compile(r"^\S+ on (.*) type (\S+) \(")


def parse_mount(out):
    s = set()
    for l in clifr_lines(out):
        m = MOUNT_RE.match(l)
        if m:
            s.add("%s %s" % (m.group(1), m.group(2)))
    return s


def accuracy_capture(st):
    """The real tools' output now, compared later with clifr's reconstruction."""
    ts = time.time()
    _, ps, _ = run(["ps", "-e", "-o", "pid=,etimes=,comm="], timeout=120)
    _, ss, _ = run(["ss", "-tan"], timeout=120)
    _, mnt, _ = run(["mount"], timeout=120)
    cap = {"ts": round(ts, 3), "ps": ps, "ss": ss, "mount": mnt}
    with open(spath("captures/%d.json" % int(ts)), "w") as f:
        json.dump(cap, f)


def accuracy_compare(st):
    now = time.time()
    capdir = spath("captures")
    for name in sorted(os.listdir(capdir)):
        if not name.endswith(".json"):
            continue
        path = os.path.join(capdir, name)
        try:
            with open(path) as f:
                cap = json.load(f)
        except (OSError, ValueError):
            os.remove(path)
            continue
        if now - cap["ts"] < ACCURACY_DELAY:
            continue
        res = compare_capture(cap)
        append_csv("accuracy.csv", ACC_COLS, res)
        details = res.pop("_details", None)
        if details:
            append_jsonl("accuracy-details.jsonl", details)
        os.remove(path)


def compare_capture(cap):
    t = utc(cap["ts"])
    res = {"ts": int(cap["ts"]), "checked_ts": int(time.time()), "error": ""}
    errors = []
    real = {}
    for l in cap["ps"].splitlines():
        f = l.split(None, 2)
        if len(f) >= 2 and f[0].isdigit():
            real[int(f[0])] = (int(f[1]) if f[1].isdigit() else 0, f[2] if len(f) > 2 else "")
    rc, out, err = clifr(["--at", t, "ps -e -o pid=,etimes=,comm="])
    rec = parse_ps(out) if rc == 0 else {}
    if rc != 0:
        errors.append("ps: " + err.strip()[-200:])
    # Processes older than two process intervals at T must be in both.
    old = 2 * duration_s(config_value("process", "30s"), 30) + 5
    real_old = {p for p, (age, _) in real.items() if age >= old}
    rec_old = {p for p, (age, _) in rec.items() if age >= old}
    missing = real_old - set(rec)
    extra = rec_old - set(real)
    res.update(ps_real=len(real_old), ps_missing=len(missing), ps_extra=len(extra))
    rl, re_ = parse_ss(cap["ss"])
    rc, out, err = clifr(["--at", t, "ss -tan"])
    cl, ce = parse_ss(out) if rc == 0 else (set(), set())
    if rc != 0:
        errors.append("ss: " + err.strip()[-200:])
    res.update(listen_real=len(rl), listen_missing=len(rl - cl), listen_extra=len(cl - rl),
               estab_real=len(re_), estab_clifr=len(ce), estab_common=len(re_ & ce))
    rm = parse_mount(cap["mount"])
    rc, out, err = clifr(["--at", t, "mount"])
    cm = parse_mount(out) if rc == 0 else set()
    if rc != 0:
        errors.append("mount: " + err.strip()[-200:])
    res.update(mounts_real=len(rm), mounts_missing=len(rm - cm), mounts_extra=len(cm - rm))
    res["error"] = " | ".join(errors)
    if missing or extra or (rl ^ cl) or (rm ^ cm) or len(re_ ^ ce) > 0:
        res["_details"] = {
            "ts": res["ts"],
            "ps_missing": sorted("%d %s age %ds" % (p, real[p][1], real[p][0]) for p in missing)[:50],
            "ps_extra": sorted("%d %s age %ds" % (p, rec[p][1], rec[p][0]) for p in extra)[:50],
            "listen_missing": sorted(rl - cl)[:50], "listen_extra": sorted(cl - rl)[:50],
            "estab_missing": sorted(" ".join(x) for x in re_ - ce)[:50],
            "estab_extra": sorted(" ".join(x) for x in ce - re_)[:50],
            "mounts_missing": sorted(rm - cm)[:50], "mounts_extra": sorted(cm - rm)[:50]}
    return res


