INFO_KEYS = ["from_ms", "to_ms", "samples", "fd_walk_samples", "skipped_samples", "db_bytes",
             "recorder_cpu_pct_one_core", "recorder_rss_avg_kb", "recorder_rss_max_kb", "sample_phase_ms",
             "guard_events", "guard_adjustments", "est_disk_per_day_bytes", "avg_processes", "avg_sockets",
             "avg_fds_per_walk", "event_mode", "tcp_mode", "reconcile", "events_by_source", "table_rows"]


def daily(st):
    now = int(time.time())
    d = {"ts": now}
    rc, out, err = clifr(["info", "--json"], timeout=1800)
    if rc == 0:
        try:
            info = json.loads(out)
            d["info"] = {k: info.get(k) for k in INFO_KEYS}
            d["schema"] = (info.get("host") or {}).get("schema_version")
            d["sealing"] = (info.get("sealing") or {}).get("state")
        except ValueError:
            d["info_error"] = "bad JSON"
    else:
        d["info_error"] = err.strip()[-300:]
    rc, out, err = run(["clifr", "--data-dir", DATA_DIR, "verify", "--integrity", "--json"], timeout=3600)
    try:
        ir = json.loads(clifr_lines(out)[0]) if out.strip() else {}
        d["integrity"] = {"files": ir.get("Files"), "logged": ir.get("Logged"), "unlogged": ir.get("Unlogged"),
                          "damaged": len(ir.get("Damaged") or []), "exit": rc}
        if ir.get("Damaged"):
            d["integrity_damaged_files"] = [str(x)[:300] for x in ir["Damaged"][:20]]
    except (ValueError, IndexError):
        d["integrity"] = {"exit": rc, "error": (err or out).strip()[-300:]}
    # Guard events, gaps and skipped samples since the previous daily check.
    since = max(st.get("daily_ts", st["started"]), now - 70 * 3600)
    rc, out, err = clifr(["--since", utc(since), "--until", utc(now), "--json", "events --type guard,gap,skipped"])
    kinds = {}
    examples = []
    for l in clifr_lines(out):
        try:
            e = json.loads(l)
        except ValueError:
            continue
        k = e.get("kind", "?")
        if k == "guard":
            k = "guard:" + (e.get("detail", "").split(":")[0].split()[0] if e.get("detail") else "?")
        kinds[k] = kinds.get(k, 0) + 1
        if len(examples) < 40:
            examples.append({"ts": e.get("ts_ms", 0) // 1000, "kind": e.get("kind"), "detail": e.get("detail", "")[:300]})
    d["events_window"] = [since, now]
    d["events"] = kinds
    d["events_examples"] = examples
    if rc != 0:
        d["events_error"] = err.strip()[-300:]
    append_jsonl("daily.jsonl", d)


