                "www-data", "messagebus", "systemd-network", "systemd-resolve", "systemd-timesync",
                "systemd-coredump", "systemd-oom", "polkitd", "dbus", "sshd", "chrony", "tss", "clifr"}


class Sanitizer(object):
    """What identifies this host or its people, and how to take it out of text."""

    def __init__(self):
        lit = set()
        for h in (socket.gethostname(), socket.getfqdn(), read("/etc/hostname").strip(),
                  read("/proc/sys/kernel/hostname").strip(), read("/proc/sys/kernel/domainname").strip()):
            if h and h not in ("localhost", "localhost.localdomain", "(none)"):
                lit.add(h)
                if len(h.split(".")[0]) >= 3:
                    lit.add(h.split(".")[0])
        self.hosts = lit
        self.ids = set()
        for x in (read("/etc/machine-id").strip(), read("/proc/sys/kernel/random/boot_id").strip()):
            if x:
                self.ids.add(x)
        for r in read_csv("hourly.csv"):
            if r.get("boot"):
                self.ids.add(r["boot"])
        self.ids |= {i.replace("-", "") for i in self.ids}
        self.ips = set()
        rc, out, _ = run(["ip", "-o", "addr"], timeout=30)
        for m in re.finditer(r"\sinet6? ([0-9a-fA-F.:]+)", out):
            if m.group(1) not in ("127.0.0.1", "::1"):
                self.ips.add(m.group(1))
        self.macs = set()
        try:
            for n in os.listdir("/sys/class/net"):
                a = read("/sys/class/net/%s/address" % n).strip()
                if a and a != "00:00:00:00:00:00":
                    self.macs.add(a)
        except OSError:
            pass
        self.users = set()
        for line in read("/etc/passwd").splitlines():
            f = line.split(":")
            if len(f) > 2 and len(f[0]) >= 3 and f[0] not in SYSTEM_USERS:
                self.users.add(f[0])

    def text(self, s):
        for h in sorted(self.hosts, key=len, reverse=True):
            s = re.sub(re.escape(h), "HOST", s, flags=re.I)
        for i in self.ids:
            s = re.sub(re.escape(i), "ID", s, flags=re.I)
        for m in self.macs:
            s = re.sub(re.escape(m), "MAC", s, flags=re.I)
        s = re.sub(r"(?i)\b([0-9a-f]{2}[:-]){5}[0-9a-f]{2}\b", "MAC", s)
        s = re.sub(r"(?i)\b[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}\b", "UUID", s)
        s = re.sub(r"[\w.+-]+@[\w-]+(\.[\w-]+)+", "EMAIL", s)
        for ip in sorted(self.ips, key=len, reverse=True):
            s = s.replace(ip, "IP")
        s = re.sub(r"(?<![\w.])(?!127\.0\.0\.1\b|0\.0\.0\.0\b)\d{1,3}(\.\d{1,3}){3}(?![\w.])", "IP", s)
        s = re.sub(r"(?i)(?<![\w:])(?=[0-9a-f:]*[a-f][0-9a-f:]*|[0-9a-f:]*::)(?:[0-9a-f]{0,4}:){2,7}[0-9a-f]{0,4}(?![\w:])",
                   lambda m: m.group(0) if m.group(0) in ("::", "::1") else "IP6", s)
        s = re.sub(r"(?i)\b(password|passwd|pwd|secret|token|api[-_]?key|access[-_]?key)\b(\s*[=:]\s*)\S+", r"\1\2X", s)
        s = re.sub(r"(?i)(--?(?:password|passwd|secret|token|api[-_]?key)\s+)\S+", r"\1X", s)
        s = re.sub(r"://[^/\s:@]+:[^@\s]+@", "://X:X@", s)
        for u in self.users:
            s = re.sub(r"(?<![\w-])%s(?![\w-])" % re.escape(u), "USER", s)
        return s

    def leaks(self, s):
        """The kinds of identifying text still in s (never the text itself)."""
        found = set()
        low = s.lower()
        if any(h.lower() in low for h in self.hosts):
            found.add("host name")
        if any(i.lower() in low for i in self.ids):
            found.add("machine or boot id")
        if any(m.lower() in low for m in self.macs):
            found.add("MAC address")
        if any(re.search(r"(?<![\w.:])%s(?![\w.:])" % re.escape(ip), s) for ip in self.ips):
            found.add("IP address of this host")
        if re.search(r"(?<![\w.])(?!127\.0\.0\.1\b|0\.0\.0\.0\b)\d{1,3}(\.\d{1,3}){3}(?![\w.])", s):
            found.add("IPv4 address")
        if re.search(r"[\w.+-]+@[\w-]+(\.[\w-]+)+", s):
            found.add("email address")
        if any(re.search(r"(?<![\w-])%s(?![\w-])" % re.escape(u), s) for u in self.users):
            found.add("user name")
        return found


