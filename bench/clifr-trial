# ---------------------------------------------------------------- helpers

def die(msg):
    sys.stderr.write("clifr-trial: %s\n" % msg)
    sys.exit(1)


def run(args, timeout=1800, env=None):
    """Runs a command; (exit code, stdout, stderr). Never raises."""
    try:
        p = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
        out, err = p.communicate(timeout=timeout)
        return p.returncode, out.decode("utf-8", "replace"), err.decode("utf-8", "replace")
    except subprocess.TimeoutExpired:
        p.kill()
        p.communicate()
        return -1, "", "timeout after %ds" % timeout
    except OSError as e:
        return -1, "", str(e)


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read()
    except (OSError, UnicodeDecodeError):
        return default


def spath(name):
    return os.path.join(STATE, name)


def load_state():
    try:
        with open(spath("state.json")) as f:
            return json.load(f)
    except (OSError, ValueError):
        return {}


def save_state(st):
    tmp = spath("state.json.tmp")
    with open(tmp, "w") as f:
        json.dump(st, f, indent=1, sort_keys=True)
    os.rename(tmp, spath("state.json"))


def append_csv(name, cols, row):
    path = spath(name)
    new = not os.path.exists(path)
    with open(path, "a") as f:
        if new:
            f.write(",".join(cols) + "\n")
        f.write(",".join(str(row.get(c, "")).replace(",", ";").replace("\n", " ") for c in cols) + "\n")


def read_csv(name):
    rows = []
    try:
        with open(spath(name)) as f:
            cols = f.readline().strip().split(",")
            for line in f:
                vals = line.rstrip("\n").split(",")
                rows.append(dict(zip(cols, vals)))
    except OSError:
        pass
    return rows


def append_jsonl(name, obj):
    with open(spath(name), "a") as f:
        f.write(json.dumps(obj, sort_keys=True) + "\n")


def read_jsonl(name):
    out = []
    for line in read(spath(name)).splitlines():
        try:
            out.append(json.loads(line))
        except ValueError:
            pass
    return out


def num(v, default=None):
    try:
        return float(v)
    except (TypeError, ValueError):
        return default


def utc(ts):
    """A Unix time as clifr's TIME, given with --tz UTC."""
    return time.strftime("%Y-%m-%d %H:%M:%S", time.gmtime(ts))


def local(ts):
    """Times in what leaves the host: UTC (the time zone tells where it is)."""
    return time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime(ts))


def day_of(ts):
    return time.strftime("%Y-%m-%d", time.gmtime(ts))


def clifr(args, timeout=900):
    """Runs clifr on the local recording with times in UTC."""
    return run(["clifr", "--data-dir", DATA_DIR, "--tz", "UTC", "--plain"] + args, timeout=timeout)


def clifr_lines(out):
    return [l for l in out.splitlines() if l and not l.startswith("#")]


def unit_props(*names):
    rc, out, _ = run(["systemctl", "show", "clifrd", "-p", ",".join(names)], timeout=30)
    props = {}
    for line in out.splitlines():
        k, _, v = line.partition("=")
        props[k] = v
    return props


def config_value(key, default):
    m = re.search(r"(?m)^\s*%s:\s*([^\s#]+)" % re.escape(key), read(CONFIG))
    return m.group(1) if m else default


def duration_s(text, default):
    m = re.match(r"^(\d+(?:\.\d+)?)(ms|s|m|h|d)?$", text or "")
    if not m:
        return default
    mult = {"ms": 0.001, "s": 1, "m": 60, "h": 3600, "d": 86400, None: 1}[m.group(2)]
    return float(m.group(1)) * mult


def size_bytes(text, default):
    m = re.match(r"^(\d+(?:\.\d+)?)([KMGT]i?B?)?$", text or "", re.I)
    if not m:
        return default
    unit = (m.group(2) or "").upper()[:1]
    return float(m.group(1)) * {"": 1, "K": 1024, "M": 1024 ** 2, "G": 1024 ** 3, "T": 1024 ** 4}[unit]


def versions():
    v = {}
    for name in ("clifr", "clifrd"):
        rc, out, _ = run(["rpm", "-q", name], timeout=30)
        if rc != 0:
            rc, out, _ = run(["dpkg-query", "-W", "-f", "${Version}", name], timeout=30)
        v[name + "_package"] = out.strip() if rc == 0 else "not installed"
    v["clifrd"] = run(["clifrd", "--version"], timeout=30)[1].strip()
    v["clifr"] = run(["clifr", "--version"], timeout=30)[1].strip()
    return v


def need_root():
    if os.geteuid() != 0:
        die("run as root (sudo)")


# ---------------------------------------------------------------- start / stop

def cmd_start(args):
    need_root()
    if shutil.which("clifr") is None:
        die("clifr is not installed (the clifr package: the queries need it)")
    if not os.path.isdir(DATA_DIR):
        die("%s does not exist: is clifrd installed and started?" % DATA_DIR)
    os.makedirs(STATE, mode=0o700, exist_ok=True)
    os.makedirs(spath("captures"), mode=0o700, exist_ok=True)
    st = load_state()
    me = os.path.realpath(sys.argv[0])
    if me != INSTALLED:
        shutil.copyfile(me, INSTALLED)
        os.chmod(INSTALLED, 0o755)
        run(["restorecon", INSTALLED], timeout=30)
    with open("/etc/systemd/system/%s.service" % UNIT, "w") as f:
        f.write("""[Unit]
Description=clifr production trial: hourly sample (clifr-trial)

[Service]
Type=oneshot
ExecStart=%s sample
Nice=19
IOSchedulingClass=idle
CPUWeight=10
MemoryMax=2G
TimeoutStartSec=45min
""" % INSTALLED)
    with open("/etc/systemd/system/%s.timer" % UNIT, "w") as f:
        f.write("""[Unit]
Description=clifr production trial: hourly sample (clifr-trial)

[Timer]
OnCalendar=hourly
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
""")
    run(["systemctl", "daemon-reload"], timeout=60)
    rc, _, err = run(["systemctl", "enable", "--now", UNIT + ".timer"], timeout=60)
    if rc != 0:
        die("could not start the timer: " + err.strip())
    if "started" not in st:
        st["started"] = int(time.time())
        st["script_version"] = VERSION
        save_state(st)
        baseline()
        q = spath("QUESTIONS.txt")
        if not os.path.exists(q):
            with open(q, "w") as f:
                f.write(QUESTIONS)
    print("clifr-trial: the hourly timer is on; data in %s" % STATE)
    print("taking the first sample now (a minute or two)...")
    cmd_sample(args)
    print("done. Next steps:")
    print("  - answer %s during the trial (it goes into the report)" % spath("QUESTIONS.txt"))
    print("  - once, on a normal day: sudo clifr-trial drill   (checked automatically a day later)")
    print("  - now and then: sudo clifr-trial status")
    print("  - after 2-4 weeks: sudo clifr-trial report, and send the .tar.gz")


def cmd_stop(args):
    need_root()
    run(["systemctl", "disable", "--now", UNIT + ".timer"], timeout=60)
    for ext in ("timer", "service"):
        try:
            os.remove("/etc/systemd/system/%s.%s" % (UNIT, ext))
        except OSError:
            pass
    run(["systemctl", "daemon-reload"], timeout=60)
    print("timer removed; the collected data stay in %s (rm -r it when done)" % STATE)


