def cmd_drill(args):
    need_root()
    st = load_state()
    if "started" not in st:
        die("not started: run clifr-trial start first")
    token = "d%s" % time.strftime("%Y%m%d%H%M%S")
    mount = "--no-mount" not in args
    if shutil.which("systemd-run") is None:
        die("systemd-run not found")
    rc, out, err = run(["systemd-run", "--unit", "clifr-trial-drill-" + token, "--description",
                        "clifr production trial: drill", INSTALLED, "drill-run", token,
                        "mount" if mount else "nomount", str(DRILL_HOLD)], timeout=60)
    if rc != 0:
        die("could not start the drill: " + err.strip())
    print("drill %s started (about %d minutes, in the background: unit clifr-trial-drill-%s)." % (token, DRILL_HOLD // 60 + 1, token))
    print("It runs a short job (exit code 3), opens a TCP connection to itself on 127.0.0.1, holds a file")
    if mount:
        print("and mounts a 1 MiB tmpfs at /run/clifr-trial-drill (removed at the end).")
    print("The hourly sample checks the recording of it after %d hours (or: clifr-trial status)." % (DRILL_CHECK_AFTER // 3600))


def drill_run(args):
    token, mount = args[0], len(args) > 1 and args[1] == "mount"
    hold = int(args[2]) if len(args) > 2 else DRILL_HOLD
    rec = {"id": token, "t_start": time.time(), "pid": os.getpid(), "mount": mount}
    try:
        ctypes.CDLL(None).prctl(15, b"clifr-drill", 0, 0, 0)  # PR_SET_NAME: the comm
    except (OSError, AttributeError):
        pass
    mdir = "/run/clifr-trial-drill"
    held = None
    socks = []
    try:
        if mount:
            os.makedirs(mdir, mode=0o700, exist_ok=True)
            rc, _, err = run(["mount", "-t", "tmpfs", "-o", "size=1m,mode=0700", "clifr-trial-drill", mdir], timeout=60)
            rec["mount_rc"] = rc
            if rc != 0:
                rec["mount_error"] = err.strip()
        fdir = mdir if mount and rec.get("mount_rc") == 0 else STATE
        rec["file"] = os.path.join(fdir, "drill-%s.txt" % token)
        held = open(rec["file"], "w")
        held.write("clifr trial drill %s\n" % token)
        held.flush()
        ls = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        ls.bind(("127.0.0.1", 0))
        ls.listen(1)
        rec["port"] = ls.getsockname()[1]
        cs = socket.create_connection(("127.0.0.1", rec["port"]))
        ac, _ = ls.accept()
        cs.sendall(b"drill")
        ac.recv(16)
        socks = [ls, cs, ac]
        rec["client_port"] = cs.getsockname()[1]
        rec["t_job"] = time.time()
        p = subprocess.Popen(["/bin/sh", "-c", "sleep 2; exit 3", "clifr-trial-drill-" + token])
        rec["job_pid"] = p.pid
        rec["job_rc"] = p.wait()
        time.sleep(max(0, hold - (time.time() - rec["t_start"]) - 30))
        rec["t_mid"] = time.time()
        time.sleep(30)
    except Exception as e:  # recorded: the check then says why
        rec["error"] = repr(e)
    finally:
        for s in socks:
            s.close()
        if held:
            held.close()
            try:
                os.remove(rec["file"])
            except OSError:
                pass
        if mount and rec.get("mount_rc") == 0:
            run(["umount", mdir], timeout=60)
        if mount:
            try:
                os.rmdir(mdir)
            except OSError:
                pass
        rec["t_end"] = time.time()
        append_jsonl("drills.jsonl", rec)


def check_drill(d):
    """Is the drill in the recording? One verdict per item."""
    out_items = {}
    if d.get("error") or "t_mid" not in d:
        return {"error": d.get("error", "drill did not finish")}
    lo, hi = utc(d["t_start"] - 60), utc(d["t_end"] + 120)
    rc, out, err = clifr(["--since", lo, "--until", hi, "--json", "events --type start,exit --name clifr-trial-drill-" + d["id"]])
    ev = [json.loads(l) for l in clifr_lines(out) if l.startswith("{")]
    starts = [e for e in ev if e.get("kind") == "start" and e.get("pid") == d["job_pid"]]
    exits = [e for e in ev if e.get("kind") == "exit" and e.get("pid") == d["job_pid"]]
    out_items["short_job"] = bool(starts) and any(e.get("detail", "").startswith("3 ") for e in exits)
    rc, out, err = clifr(["--since", lo, "--until", hi, "--json", "events --type start,exit --name drill-run." + d["id"]])
    ev = [json.loads(l) for l in clifr_lines(out) if l.startswith("{")]
    out_items["drill_process"] = any(e.get("kind") == "start" and e.get("pid") == d["pid"] for e in ev) and \
        any(e.get("kind") == "exit" and e.get("pid") == d["pid"] for e in ev)
    rc, out, err = clifr(["--at", utc(d["t_mid"]), "ss -tanp"])
    mine = [l for l in clifr_lines(out) if "pid=%d," % d["pid"] in l]
    port = ":%d" % d["port"]
    out_items["tcp_listen"] = any(l.startswith("LISTEN") and port in l.split()[3] for l in mine)
    out_items["tcp_connection"] = sum(1 for l in mine if l.startswith("ESTAB")) >= 2
    rc, out, err = clifr(["--at", utc(d["t_mid"]), "lsof -p %d" % d["pid"]])
    out_items["held_file"] = any(d["file"] in l for l in clifr_lines(out))
    if d.get("mount") and d.get("mount_rc") == 0:
        rc, out, err = clifr(["--since", lo, "--until", hi, "--json", "events --type mount,unmount"])
        ev = [json.loads(l) for l in clifr_lines(out) if l.startswith("{")]
        hit = [e.get("kind") for e in ev if e.get("detail", "").startswith("/run/clifr-trial-drill ")]
        out_items["mount"] = "mount" in hit
        out_items["unmount"] = "unmount" in hit
    return out_items


def check_drills(st, force):
    done = {r["id"] for r in read_jsonl("drill-checks.jsonl")}
    now = time.time()
    for d in read_jsonl("drills.jsonl"):
        if d["id"] in done:
            continue
        age = now - d.get("t_end", now)
        if age < DRILL_CHECK_AFTER and not force:
            continue
        if age > 66 * 3600:
            res = {"error": "not checked within the recording's 72 hours"}
        elif age < ACCURACY_DELAY:
            continue
        else:
            res = check_drill(d)
        append_jsonl("drill-checks.jsonl", {"id": d["id"], "checked_ts": int(now), "age_h": round(age / 3600, 1),
                                            "items": res})


# ---------------------------------------------------------------- analysis

def analyze(st):
    """Every number the report needs, and the verdicts."""
    a = {"verdicts": []}
    rows = read_csv("hourly.csv")
    started = st.get("started", 0)
    now = int(time.time())
    a["days"] = round((now - started) / 86400.0, 1)
    a["samples"] = len({int(num(r.get("ts"), 0)) // 3600 for r in rows})  # hours with a sample
    a["expected_samples"] = int((now - started) / 3600) + 1
    # Boots, kernels, versions: what the trial went through.
    boots, kernels, vers = [], [], []
    for r in rows:
        for lst, k in ((boots, "boot"), (kernels, "kernel"), (vers, "clifrd_version")):
            if r.get(k) and (not lst or lst[-1] != r[k]):
                lst.append(r[k])
    a["reboots"] = max(0, len(boots) - 1)
    a["kernels"] = kernels
    a["clifrd_versions"] = vers
    a["not_active_samples"] = sum(1 for r in rows if r.get("state") != "active")
    # clifrd's CPU: positive deltas of the same process; per day.
    per_day = {}
    peak_hour = 0.0
    prev = None
    for r in rows:
        ts = num(r.get("ts"))
        if prev and r.get("pid") == prev.get("pid") and r.get("pid_start") == prev.get("pid_start") and \
                num(r.get("cpu_ticks")) is not None and num(prev.get("cpu_ticks")) is not None:
            dt = ts - num(prev["ts"])
            dc = (num(r["cpu_ticks"]) - num(prev["cpu_ticks"])) / num(r.get("clk_tck"), 100)
            hj = num(r.get("host_jiffies"), 0) - num(prev.get("host_jiffies"), 0)
            hi = num(r.get("host_idle_jiffies"), 0) - num(prev.get("host_idle_jiffies"), 0)
            if dt > 0 and dc >= 0:
                day = day_of(ts)
                p = per_day.setdefault(day, {"cpu_s": 0.0, "secs": 0.0, "host_busy": 0.0, "host_all": 0.0,
                                            "rss_max": 0, "hwm_max": 0, "load_max": 0.0, "samples": 0})
                p["cpu_s"] += dc
                p["secs"] += dt
                if hj > 0:
                    p["host_busy"] += hj - hi
                    p["host_all"] += hj
                if dt >= 1800:
                    peak_hour = max(peak_hour, dc / dt * 100)
        if r.get("ts"):
            day = day_of(num(r["ts"]))
            p = per_day.setdefault(day, {"cpu_s": 0.0, "secs": 0.0, "host_busy": 0.0, "host_all": 0.0,
                                        "rss_max": 0, "hwm_max": 0, "load_max": 0.0, "samples": 0})
            p["samples"] += 1
            p["rss_max"] = max(p["rss_max"], int(num(r.get("rss_kb"), 0)))
            p["hwm_max"] = max(p["hwm_max"], int(num(r.get("hwm_kb"), 0)))
            p["cg_max"] = max(p.get("cg_max", 0), int(num(r.get("cg_mem_peak"), 0) or num(r.get("cg_mem"), 0)))
            p["load_max"] = max(p["load_max"], num(r.get("load5"), 0))
            p["data_bytes"] = int(num(r.get("data_bytes"), 0))
            p["free_bytes"] = int(num(r.get("fs_free_bytes"), 0))
            p["cpus"] = r.get("host_cpus")
        prev = r
    a["per_day"] = per_day
    tot_cpu = sum(p["cpu_s"] for p in per_day.values())
    tot_secs = sum(p["secs"] for p in per_day.values())
    a["cpu_pct_one_core"] = tot_cpu / tot_secs * 100 if tot_secs else None
    a["cpu_pct_peak_hour"] = peak_hour
    days_cpu = {d: p["cpu_s"] / p["secs"] * 100 for d, p in per_day.items() if p["secs"] >= 6 * 3600}
    a["cpu_days_over_budget"] = sorted(d for d, v in days_cpu.items() if v > 2.0)
    a["mem_peak_kb"] = max([p["hwm_max"] for p in per_day.values()] + [0])
    a["cg_peak_bytes"] = max([p.get("cg_max", 0) for p in per_day.values()] + [0])
    a["data_max_bytes"] = max([int(num(r.get("data_bytes"), 0)) for r in rows] + [0])
    # Journal: unplanned stops, warnings, message templates.
    jl = read_jsonl("journal.jsonl")
    a["journal_lines"] = len([l for l in jl if l["ts"] >= started])
    trial = [l for l in jl if l["ts"] >= started]
    a["unplanned"] = [l for l in trial if l["comm"] != "clifrd" and UNPLANNED.search(l["msg"])]
    a["unplanned_before"] = [l for l in jl if l["ts"] < started and l["comm"] != "clifrd" and UNPLANNED.search(l["msg"])]
    a["starts"] = sum(1 for l in trial if l["comm"] != "clifrd" and l["msg"].startswith("Started "))
    tmpl = {}
    for l in trial:
        t = ("clifrd: " if l["comm"] == "clifrd" else "systemd: ") + template(l["msg"])
        tmpl[t] = tmpl.get(t, 0) + 1
    a["journal_templates"] = sorted(tmpl.items(), key=lambda x: -x[1])
    # Daily: integrity, guard events, drops, info.
    daily = read_jsonl("daily.jsonl")
    a["daily_checks"] = len(daily)
    a["integrity_damaged"] = sum(d.get("integrity", {}).get("damaged", 0) or 0 for d in daily)
    a["integrity_errors"] = sum(1 for d in daily if "error" in d.get("integrity", {}))
    ev = {}
    for d in daily:
        for k, v in d.get("events", {}).items():
            ev[k] = ev.get(k, 0) + v
    a["events"] = ev
    drops = {}
    span_h = []
    for d in daily:
        info = d.get("info") or {}
        for src, s in (info.get("events_by_source") or {}).items():
            if s.get("dropped"):
                drops[src] = max(drops.get(src, 0), s["dropped"])
        if info.get("from_ms") and info.get("to_ms"):
            span_h.append((info["to_ms"] - info["from_ms"]) / 3600000.0)
    a["drops_max_per_window"] = drops
    a["retention_span_h_max"] = max(span_h) if span_h else None
    last = next((d.get("info") for d in reversed(daily) if d.get("info")), None) or {}
    a["last_info"] = last
    # Accuracy.
    acc = read_csv("accuracy.csv")
    a["accuracy_checks"] = len(acc)
    def ssum(k):
        return sum(int(num(r.get(k), 0)) for r in acc)
    a["acc"] = {k: ssum(k) for k in ACC_COLS[2:-1]}
    a["acc_errors"] = [r["error"] for r in acc if r.get("error")]
    # Drills.
    a["drills"] = read_jsonl("drills.jsonl")
    a["drill_checks"] = read_jsonl("drill-checks.jsonl")
    return a


def verdicts(a, st):
    v = []

    def add(name, status, why):
        v.append((name, status, why))

    days = a["days"]
    add("duration", "PASS" if days >= 14 else "NOT MET", "%.1f days (want 14 or more)" % days)
    cov = min(1.0, a["samples"] / float(max(1, a["expected_samples"])))
    add("evidence coverage", "PASS" if cov >= 0.9 else "NOT MET",
        "%d of %d hourly samples (%.0f%%)" % (a["samples"], a["expected_samples"], cov * 100))
    # Stability.
    n = len(a["unplanned"])
    add("no unplanned clifrd stop", "PASS" if n == 0 else "FAIL",
        ("none in the journal" if n == 0 else "%d journal lines: %s" % (n, "; ".join(
            "%s %s" % (local(l["ts"]), template(l["msg"])) for l in a["unplanned"][:5]))) +
        ("; before the trial: %d" % len(a["unplanned_before"]) if a["unplanned_before"] else ""))
    na = a["not_active_samples"]
    add("clifrd running at every sample", "PASS" if na == 0 else "FAIL", "%d samples found it not active" % na)
    add("went through a reboot", "PASS" if a["reboots"] >= 1 else "NOT MET", "%d reboots" % a["reboots"])
    add("went through a kernel/OS update", "PASS" if len(a["kernels"]) >= 2 else "NOT MET",
        " -> ".join(a["kernels"]) or "?")
    add("went through a clifrd upgrade", "PASS" if len(a["clifrd_versions"]) >= 2 else "NOT MET",
        " -> ".join(a["clifrd_versions"]) or "?")
    # Cost.
    c = a["cpu_pct_one_core"]
    if c is None:
        add("CPU within 2% of one core", "NO DATA", "")
    else:
        bad = a["cpu_days_over_budget"]
        add("CPU within 2% of one core", "PASS" if c <= 2.0 and not bad else "FAIL",
            "%.2f%% average, busiest hour %.2f%%; days over 2%%: %s" % (c, a["cpu_pct_peak_hour"], ", ".join(bad) or "none"))
    mm = size_bytes(st.get("memory_max", ""), 768 * 1048576)
    peak = max(a["mem_peak_kb"] * 1024, a["cg_peak_bytes"])
    add("memory below the unit's limit", "PASS" if peak and peak < 0.9 * mm else ("NO DATA" if not peak else "FAIL"),
        "peak %.0f MiB (process %.0f MiB, cgroup %.0f MiB) of %.0f MiB" % (
            peak / 1048576.0, a["mem_peak_kb"] / 1024.0, a["cg_peak_bytes"] / 1048576.0, mm / 1048576.0))
    ms = size_bytes(config_value("max_size", "2G"), 2 * 1024 ** 3)
    add("disk within max_size", "PASS" if a["data_max_bytes"] <= ms * 1.05 else "FAIL",
        "at most %.2f GiB of %.2f GiB" % (a["data_max_bytes"] / 1024.0 ** 3, ms / 1024.0 ** 3))
    ret_h = duration_s(config_value("retention", "72h"), 72 * 3600) / 3600
    span = a["retention_span_h_max"]
    add("retention keeps what it should, no more", "NO DATA" if span is None else
        ("PASS" if ret_h - 2 <= span <= ret_h + 2 or (span < ret_h - 2 and a["data_max_bytes"] >= ms * 0.9) else "FAIL"),
        "" if span is None else "longest recording span %.1f h (retention %.0f h)" % (span, ret_h))
    # Completeness.
    lost = {k: x for k, x in a["drops_max_per_window"].items() if k != "ebpf_missed_runs"}
    lost_ev = a["events"].get("guard:events_lost", 0)
    add("no lost events", "PASS" if not lost and not lost_ev else "FAIL",
        "drops by source: %s; events_lost guard events: %d" % (json.dumps(lost, sort_keys=True) if lost else "none", lost_ev))
    gaps = a["events"].get("gap", 0)
    add("gaps only at reboots and upgrades", "PASS" if gaps <= a["reboots"] + len(a["clifrd_versions"]) + a["starts"] else "CHECK",
        "%d gaps, %d reboots, %d clifrd starts" % (gaps, a["reboots"], a["starts"]))
    # Accuracy.
    if not a["daily_checks"]:
        add("integrity of the data files", "NO DATA", "")
    else:
        dmg = a["integrity_damaged"]
        add("integrity of the data files", "PASS" if dmg == 0 and not a["integrity_errors"] else "FAIL",
            "%d daily checks, %d damaged files, %d checks failed to run" % (a["daily_checks"], dmg, a["integrity_errors"]))
    x = a["acc"]
    if not a["accuracy_checks"]:
        add("accuracy spot checks", "NO DATA", "")
    else:
        ps_ok = x["ps_real"] and (x["ps_missing"] + x["ps_extra"]) <= 0.005 * x["ps_real"]
        ls_ok = (x["listen_missing"] + x["listen_extra"]) <= max(1, 0.01 * x["listen_real"])
        es = x["estab_common"] / float(max(1, x["estab_real"] + x["estab_clifr"] - x["estab_common"]))
        es_ok = es >= 0.95 or x["estab_real"] == 0
        mt_ok = (x["mounts_missing"] + x["mounts_extra"]) <= max(1, 0.005 * x["mounts_real"])
        ok = ps_ok and ls_ok and es_ok and mt_ok and not a["acc_errors"]
        add("accuracy spot checks", "PASS" if ok else "FAIL",
            "%d checks; processes %d, %d missing, %d extra; listeners %d, %d missing, %d extra; established "
            "connections %.1f%% the same (%d real, %d clifr); mounts %d, %d missing, %d extra; %d errors" % (
                a["accuracy_checks"], x["ps_real"], x["ps_missing"], x["ps_extra"], x["listen_real"],
                x["listen_missing"], x["listen_extra"], es * 100, x["estab_real"], x["estab_clifr"],
                x["mounts_real"], x["mounts_missing"], x["mounts_extra"], len(a["acc_errors"])))
    if not a["drill_checks"]:
        add("drill reconstructed a day later", "NOT MET",
            "%d drills run, none checked yet" % len(a["drills"]))
    else:
        items = {}
        for c in a["drill_checks"]:
            for k, val in c["items"].items():
                items.setdefault(k, []).append(val)
        failed = sorted(k for k, vals in items.items() if k == "error" or not all(vals))
        add("drill reconstructed a day later", "PASS" if not failed else "FAIL",
            "%d checks; items %s; failed: %s" % (len(a["drill_checks"]), ", ".join(sorted(items)), ", ".join(failed) or "none"))
    return v


# ---------------------------------------------------------------- status / report

def cmd_status(args):
    need_root()
    st = load_state()
    if "started" not in st:
        die("not started")
    check_drills(st, force="--check-drills" in args)
    a = analyze(st)
    st.setdefault("memory_max", read_memory_max())
    t = read("/etc/systemd/system/%s.timer" % UNIT)
    print("clifr-trial since %s (%.1f days); timer %s" % (local(st["started"]), a["days"], "on" if t else "OFF"))
    for name, status, why in verdicts(a, st):
        print("  %-8s %-40s %s" % (status, name, why))


def read_memory_max():
    v = unit_props("MemoryMax").get("MemoryMax", "")
    return v if v.isdigit() else ""


def fmt_table(rows, cols):
    widths = [max(len(str(c)), max([len(str(r[i])) for r in rows] + [0])) for i, c in enumerate(cols)]
    out = ["  ".join(str(c).rjust(w) for c, w in zip(cols, widths))]
    for r in rows:
        out.append("  ".join(str(x).rjust(w) for x, w in zip(r, widths)))
    return "\n".join(out)


def summary_text(a, st):
    b = {}
    try:
        with open(spath("baseline.json")) as f:
            b = json.load(f)
    except (OSError, ValueError):
        pass
    vs = verdicts(a, st)
    fails = [x for x in vs if x[1] == "FAIL"]
    notmet = [x for x in vs if x[1] in ("NOT MET", "NO DATA", "CHECK")]
    overall = "FAILED" if fails else ("INCOMPLETE" if notmet else "PASSED")
    L = []
    L.append("clifr production trial: %s" % overall)
    L.append("=" * 40)
    L.append("report written %s by clifr-trial %s; trial started %s (%.1f days)" % (
        local(time.time()), VERSION, local(st["started"]), a["days"]))
    L.append("anonymized: numbers, verdicts and clifr's own words only; times in UTC")
    L.append("")
    L.append("Server")
    L.append("  %s, kernel %s, %s, %s CPUs, %s GiB RAM, cgroup %s, SELinux %s, BTF %s" % (
        b.get("os"), b.get("kernel"), b.get("arch"), b.get("cpus"), b.get("mem_total_gib"), b.get("cgroup"),
        b.get("selinux"), "yes" if b.get("btf") else "no"))
    L.append("  packages: clifrd %s, clifr %s; unit drop-ins %s; config changed from the package's: %s" % (
        b.get("clifrd_package"), b.get("clifr_package"), b.get("unit_dropins"), b.get("config_changed")))
    L.append("  recording: %s; %s" % (a["last_info"].get("event_mode", "?"), a["last_info"].get("tcp_mode", "?")))
    L.append("  other agents running: %s; eBPF programs loaded at start: %s" % (
        ", ".join(b.get("agents", [])) or "none of the known ones", b.get("bpf_programs")))
    L.append("  baseline: %s" % b.get("note", "?"))
    L.append("")
    L.append("Verdicts (PASS / FAIL; NOT MET = the trial did not cover it; NO DATA)")
    for name, status, why in vs:
        L.append("  %-8s %-40s %s" % (status, name, why))
    L.append("")
    L.append("Per day (clifrd's CPU as %% of one core; memory = process peak RSS; host = whole machine)")
    rows = []
    for d in sorted(a["per_day"]):
        p = a["per_day"][d]
        rows.append([d, p["samples"], "%.2f" % (p["cpu_s"] / p["secs"] * 100) if p["secs"] else "-",
                     "%.0f" % (p["hwm_max"] / 1024.0), "%.0f" % (p.get("cg_max", 0) / 1048576.0),
                     "%.1f" % (p["host_busy"] / p["host_all"] * 100) if p["host_all"] else "-",
                     "%.1f" % p["load_max"], "%.2f" % (p.get("data_bytes", 0) / 1024.0 ** 3)])
    L.append(fmt_table(rows, ["day", "samples", "cpu%", "peakMiB", "cgMiB", "host%", "load5max", "dataGiB"]))
    L.append("")
    li = a["last_info"]
    if li:
        L.append("Latest clifr info (the last %s hours)" % (
            "%.0f" % ((li.get("to_ms", 0) - li.get("from_ms", 0)) / 3600000.0)))
        L.append("  samples %s, skipped %s, fd walks %s; avg processes %.0f, sockets %.0f, fds per walk %.0f" % (
            li.get("samples"), li.get("skipped_samples"), li.get("fd_walk_samples"), li.get("avg_processes") or 0,
            li.get("avg_sockets") or 0, li.get("avg_fds_per_walk") or 0))
        L.append("  recorder CPU %.2f%% of one core, RSS avg %.0f / max %.0f MiB, est. disk per day %.0f MiB" % (
            li.get("recorder_cpu_pct_one_core") or 0, (li.get("recorder_rss_avg_kb") or 0) / 1024.0,
            (li.get("recorder_rss_max_kb") or 0) / 1024.0, (li.get("est_disk_per_day_bytes") or 0) / 1048576.0))
        tot = (li.get("sample_phase_ms") or {}).get("total") or {}
        L.append("  sample time ms: p50 %s p95 %s p99 %s max %s" % (tot.get("p50"), tot.get("p95"), tot.get("p99"), tot.get("max")))
        rc = li.get("reconcile") or {}
        L.append("  TCP keyframes %s: %s missing from events, %s extra in events" % (
            rc.get("keyframes"), rc.get("missing_from_events"), rc.get("extra_in_events")))
        L.append("")
    L.append("Guard events, gaps, skipped samples over the trial (daily windows)")
    for k, n in sorted(a["events"].items()):
        L.append("  %-40s %d" % (k, n))
    if not a["events"]:
        L.append("  none")
    L.append("eBPF/source drops (the most in one 72-hour window): %s" % (
        json.dumps(a["drops_max_per_window"], sort_keys=True) if a["drops_max_per_window"] else "none"))
    L.append("")
    L.append("clifrd's journal: %d lines; by message (numbers, paths, addresses replaced)" % a["journal_lines"])
    for t, n in a["journal_templates"][:40]:
        L.append("  %6d  %s" % (n, t))
    L.append("")
    L.append("Drills")
    for d in a["drills"]:
        chk = next((c for c in a["drill_checks"] if c["id"] == d["id"]), None)
        L.append("  %s at %s: %s" % (d["id"], local(d["t_start"]),
                                     "not checked yet" if not chk else "checked %.1f h later: %s" % (
                                         chk["age_h"], json.dumps(chk["items"], sort_keys=True))))
    if not a["drills"]:
        L.append("  none run")
    L.append("")
    L.append("Admin's answers: QUESTIONS.txt in this archive.")
    return "\n".join(L) + "\n"


def cmd_report(args):
    need_root()
    st = load_state()
    if "started" not in st:
        die("not started")
    outdir = os.getcwd()
    if "--out" in args:
        outdir = args[args.index("--out") + 1]
    print("running the checks once more (a few minutes)...")
    cmd_sample([])
    check_drills(st, force=True)
    st = load_state()
    st["memory_max"] = read_memory_max()
    a = analyze(st)
    files = report_files(a, st)
    # Every file through the sanitizer, then a scan for anything left.
    san = sanitizer()
    problems = []
    for n in sorted(files):
        files[n] = san.text(files[n])
        found = san.leaks(files[n])
        if found:
            problems.append("%s: %s" % (n, ", ".join(sorted(found))))
    if problems:
        die("report NOT written: identifying text left after sanitizing (%s); please tell the clifr "
            "developers which kinds, without the text" % "; ".join(problems))
    name = "clifr-trial-%s" % time.strftime("%Y%m%d-%H%M", time.gmtime())
    target = os.path.join(outdir, name + ".tar.gz")
    with tarfile.open(target, "w:gz") as tf:
        for n in sorted(files):
            data = files[n].encode("utf-8")
            ti = tarfile.TarInfo("%s/%s" % (name, n))
            ti.size, ti.mtime, ti.mode = len(data), int(time.time()), 0o644
            ti.uname = ti.gname = ""
            tf.addfile(ti, io.BytesIO(data))
    os.chmod(target, 0o600)
    print(files["SUMMARY.txt"].split("\n\nPer day")[0])
    print("\nreport: %s" % target)
    print("It holds numbers and verdicts only (sanitized and scanned). QUESTIONS.txt is the admin's own")
    print("text: read it once more before sending. Look inside: tar -xzf %s" % os.path.basename(target))


def report_files(a, st):
    """The report's files as text, before the sanitizer: only numbers, verdicts
    and clifr's own words."""
    files = {"SUMMARY.txt": summary_text(a, st)}
    boots = {}
    lines = [",".join(HOURLY_COLS)]
    for r in read_csv("hourly.csv"):
        r["boot"] = "boot%d" % boots.setdefault(r.get("boot"), len(boots) + 1)
        lines.append(",".join(str(r.get(c, "")) for c in HOURLY_COLS))
    files["hourly.csv"] = "\n".join(lines) + "\n"
    lines = [",".join(ACC_COLS)]
    for r in read_csv("accuracy.csv"):
        r["error"] = template(r.get("error", "")) if r.get("error") else ""
        lines.append(",".join(str(r.get(c, "")).replace(",", ";") for c in ACC_COLS))
    files["accuracy.csv"] = "\n".join(lines) + "\n"
    out = []
    for d in read_jsonl("daily.jsonl"):
        d.pop("events_examples", None)
        d.pop("integrity_damaged_files", None)
        if d.get("info"):
            d["info"].pop("guard_adjustments", None)
        for k in ("info_error", "events_error"):
            if k in d:
                d[k] = template(d[k])
        if "error" in d.get("integrity", {}):
            d["integrity"]["error"] = template(d["integrity"]["error"])
        out.append(json.dumps(d, sort_keys=True))
    files["daily.jsonl"] = "\n".join(out) + "\n"
    checks = {c["id"]: c for c in a["drill_checks"]}
    out = []
    for d in a["drills"]:
        d = {k: d.get(k) for k in ("id", "t_start", "t_mid", "t_end", "mount", "mount_rc", "job_rc", "error")}
        if d["error"]:
            d["error"] = template(d["error"])
        c = checks.get(d["id"])
        if c and "error" in c["items"]:
            c["items"]["error"] = template(c["items"]["error"])
        d["check"] = c
        out.append(json.dumps(d, sort_keys=True))
    files["drills.jsonl"] = "\n".join(out) + "\n"
    try:
        with open(spath("baseline.json")) as f:
            b = json.load(f)
    except (OSError, ValueError):
        b = {}
    files["baseline.json"] = json.dumps(b, indent=1, sort_keys=True) + "\n"
    files["journal-summary.txt"] = "".join("%6d  %s\n" % (n, t) for t, n in a["journal_templates"])
    files["doctor.txt"] = "".join(template_doctor(l) + "\n" for l in read(spath("doctor.txt")).splitlines())
    if os.path.exists(spath("QUESTIONS.txt")):
        files["QUESTIONS.txt"] = read(spath("QUESTIONS.txt"))
    return files


def template_doctor(line):
    """clifrd doctor's lines keep their words; numbers of sockets, free space
    and the owner stay (not identifying)."""
    return re.sub(r"(?<=owner )\d+:\d+", "UID:GID", line)


# ---------------------------------------------------------------- main

def main():
    os.umask(0o077)
    args = sys.argv[1:]
    cmds = {"start": cmd_start, "stop": cmd_stop, "sample": cmd_sample, "status": cmd_status,
            "drill": cmd_drill, "report": cmd_report}
    if not args or args[0] in ("-h", "--help", "help"):
        print(USAGE)
        return
    if args[0] == "drill-run":
        drill_run(args[1:])
        return
    if args[0] == "--version":
        print("clifr-trial", VERSION)
        return
    if args[0] not in cmds:
        die("unknown command %r (see clifr-trial --help)" % args[0])
    cmds[args[0]](args[1:])


if __name__ == "__main__":
    main()
