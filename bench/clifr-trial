def baseline():
    """What the server is and what else runs on it, at start."""
    b = {"ts": int(time.time()), "note": "taken after clifrd was installed: no pre-install baseline"}
    osr = dict(re.findall(r'(?m)^([A-Z_]+)="?([^"\n]*)"?$', read("/etc/os-release")))
    b["os"] = "%s %s" % (osr.get("ID", "?"), osr.get("VERSION_ID", "?"))
    b["kernel"] = os.uname().release
    b["arch"] = os.uname().machine
    b["cpus"] = os.cpu_count()
    m = re.search(r"MemTotal:\s+(\d+)", read("/proc/meminfo"))
    b["mem_total_gib"] = round(int(m.group(1)) / 1048576.0, 1) if m else None
    b["cgroup"] = "v2" if os.path.exists("/sys/fs/cgroup/cgroup.controllers") else "v1"
    b["selinux"] = run(["getenforce"], timeout=10)[1].strip() or "n/a"
    b["btf"] = os.path.exists("/sys/kernel/btf/vmlinux")
    b["psi"] = os.path.exists("/proc/pressure/cpu")
    b.update(versions())
    p = unit_props("DropInPaths", "MemoryMax", "CPUQuotaPerSecUSec", "ActiveEnterTimestamp")
    b["unit_dropins"] = len([x for x in p.get("DropInPaths", "").split() if x])
    b["unit_memory_max"] = p.get("MemoryMax", "")
    b["unit_cpu_quota"] = p.get("CPUQuotaPerSecUSec", "")
    rc, out, _ = run(["rpm", "-V", "clifrd"], timeout=60)
    b["config_changed"] = CONFIG in out
    cfg = {}
    for key in ("retention", "max_size", "process", "system", "files", "flush", "process_events", "tcp",
                "cpu_budget", "memory_guard", "metrics", "serve"):
        cfg[key] = config_value(key, "")
    for key in ("metrics", "serve"):  # addresses: only whether it is on
        cfg[key] = "on" if cfg[key] not in ("", '""', "''", "false", "off") else "off"
    b["config"] = cfg
    comms = set()
    for pid in os.listdir("/proc"):
        if pid.isdigit():
            comms.add(read("/proc/%s/comm" % pid).strip())
    b["agents"] = sorted(c for c in comms if any(c == a or (a.endswith("_") and c.startswith(a)) for a in AGENTS))
    b["processes"] = len([p for p in os.listdir("/proc") if p.isdigit()])
    rc, out, _ = run(["bpftool", "prog", "show", "--json"], timeout=60)
    if rc == 0:
        try:
            progs = json.loads(out)
            b["bpf_programs"] = len(progs)
            b["bpf_programs_by_type"] = {}
            for pr in progs:
                t = pr.get("type", "?")
                b["bpf_programs_by_type"][t] = b["bpf_programs_by_type"].get(t, 0) + 1
        except ValueError:
            b["bpf_programs"] = "unknown"
    else:
        b["bpf_programs"] = "unknown (no bpftool)"
    rc, out, err = run(["clifrd", "doctor"], timeout=300)
    with open(spath("doctor.txt"), "w") as f:
        f.write(out + err)
    with open(spath("baseline.json"), "w") as f:
        json.dump(b, f, indent=1, sort_keys=True)


# ---------------------------------------------------------------- hourly sample

def pid_stats(pid):
    s = read("/proc/%s/stat" % pid)
    if not s:
        return {}
    fields = s[s.rfind(")") + 2:].split()
    status = read("/proc/%s/status" % pid)
    rss = re.search(r"VmRSS:\s+(\d+)", status)
    hwm = re.search(r"VmHWM:\s+(\d+)", status)
    return {"cpu_ticks": int(fields[11]) + int(fields[12]), "pid_start": fields[19],
            "rss_kb": rss.group(1) if rss else "", "hwm_kb": hwm.group(1) if hwm else ""}


def dir_size(path):
    total, files = 0, 0
    for root, dirs, names in os.walk(path):
        for n in names:
            try:
                total += os.lstat(os.path.join(root, n)).st_blocks * 512
                files += 1
            except OSError:
                pass
    return total, files


def psi(kind):
    m = re.search(r"some avg10=\S+ avg60=\S+ avg300=(\S+)", read("/proc/pressure/" + kind))
    return m.group(1) if m else ""


def hourly_row():
    now = int(time.time())
    p = unit_props("ActiveState", "NRestarts", "MainPID", "MemoryCurrent", "MemoryPeak")
    row = {"ts": now, "boot": read("/proc/sys/kernel/random/boot_id").strip(), "kernel": os.uname().release,
           "clifrd_version": run(["clifrd", "--version"], timeout=30)[1].strip().replace("clifrd ", ""),
           "state": p.get("ActiveState", ""), "n_restarts": p.get("NRestarts", ""), "pid": p.get("MainPID", ""),
           "clk_tck": os.sysconf("SC_CLK_TCK")}
    for k in ("MemoryCurrent", "MemoryPeak"):
        v = p.get(k, "")
        row["cg_mem" if k == "MemoryCurrent" else "cg_mem_peak"] = v if v.isdigit() and int(v) < 2 ** 62 else ""
    if row["pid"] not in ("", "0"):
        row.update(pid_stats(row["pid"]))
    row["data_bytes"], row["data_files"] = dir_size(os.path.realpath(DATA_DIR))
    try:
        sv = os.statvfs(DATA_DIR)
        row["fs_free_bytes"] = sv.f_bavail * sv.f_frsize
    except OSError:
        pass
    cpu = read("/proc/stat").splitlines()[0].split()[1:]
    vals = [int(x) for x in cpu[:8]]
    row["host_jiffies"] = sum(vals)
    row["host_idle_jiffies"] = vals[3] + vals[4]
    row["host_cpus"] = os.cpu_count()
    row["load1"], row["load5"], row["load15"] = read("/proc/loadavg").split()[:3]
    mi = read("/proc/meminfo")
    for key, col in (("MemTotal", "mem_total_kb"), ("MemAvailable", "mem_avail_kb")):
        m = re.search(key + r":\s+(\d+)", mi)
        row[col] = m.group(1) if m else ""
    row["psi_cpu"], row["psi_mem"], row["psi_io"] = psi("cpu"), psi("memory"), psi("io")
    return row


def journal_since(since_ts):
    """clifrd's journal (its own lines and systemd's about it) since a Unix time."""
    since = time.strftime("%Y-%m-%d %H:%M:%S", time.localtime(since_ts))
    rc, out, err = run(["journalctl", "-u", "clifrd", "--since", since, "-o", "json", "--no-pager"], timeout=600)
    lines = []
    for raw in out.splitlines():
        try:
            e = json.loads(raw)
        except ValueError:
            continue
        msg = e.get("MESSAGE", "")
        if isinstance(msg, list):
            msg = bytes(msg).decode("utf-8", "replace")
        ts = int(e.get("__REALTIME_TIMESTAMP", "0")) // 1000000
        lines.append({"ts": ts, "comm": e.get("_COMM", ""), "msg": msg})
    return lines


UNPLANNED = re.compile(r"Failed with result|code=killed|code=dumped|status=\d+/\w+|Scheduled restart job|oom-kill|"
                       r"Main process exited, code=exited, status=[1-9]|panic:|fatal error:")


def template(msg, hostname=None):
    """A free-text line (journal, error) reduced to clifr's own words: the
    host's names, addresses, paths, quoted text, numbers and every word that
    is not in clifrd's or clifr's binaries (process, user, mount names) are
    replaced."""
    msg = re.sub(r"^clifrd: \d+/\d+/\d+ \d+:\d+:\d+(\.\d+)? ", "", msg)
    msg = sanitizer().text(msg)
    msg = re.sub(r"\"[^\"]*\"|'[^']*'", "Q", msg)
    msg = re.sub(r"(/[^\s,:;()\"']+)+", "PATH", msg)
    msg = re.sub(r"(?i)\b[0-9a-f]{8,}\b", "HEX", msg)
    msg = re.sub(r"=\S+", "=V", msg)
    msg = re.sub(r"\d+(\.\d+)?", "N", msg)
    vocab = vocabulary()
    msg = re.sub(r"[A-Za-z][A-Za-z_-]*", lambda m: m.group(0) if m.group(0).isupper() or m.group(0).lower() in vocab else "X", msg)
    return msg[:200]


_vocab = None


def vocabulary():
    """Lower-case words in clifrd's and clifr's binaries: clifr's own messages."""
    global _vocab
    if _vocab is None:
        _vocab = set()
        for b in ("/usr/sbin/clifrd", "/usr/bin/clifr"):
            try:
                with open(b, "rb") as f:
                    data = f.read()
            except OSError:
                continue
            for w in re.findall(rb"[A-Za-z][a-z]{1,30}", data):
                _vocab.add(w.decode().lower())
        for u in sanitizer().users:
            _vocab.discard(u.lower())
    return _vocab


